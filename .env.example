# Copy to .env (git-ignored) and fill in. Never commit real keys.
OPENROUTER_API_KEY=
# OpenRouter model slug, format provider/model
OPENROUTER_MODEL=anthropic/claude-haiku-5-5
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=policy-agent-dev

# Optional (added in later steps)
OPENAI_API_KEY=      # embeddings / cross-family judge
VOYAGE_API_KEY=      # embeddings / re-rank
COHERE_API_KEY=      # re-rank
